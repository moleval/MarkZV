;;;=====================================================================
;;; MarkZV — внешние базы профильных систем (ПРИМЕР)
;;;
;;; Как подключить:
;;;   1) скопировать этот файл рядом с MarkZV.lsp под именем
;;;      MarkZV-bases.lsp (имя задаётся переменной *mk:bases-file*);
;;;   2) заменить пример своими данными;
;;;   3) перезагрузить MarkZV.lsp — файл подхватывается автоматически,
;;;      в консоли появится «[OK] Базы профилей: ...»;
;;;   4) проверить командой МАРКАВБАЗЫ.
;;;
;;; Таблицу можно сгенерировать из книги Excel:
;;;   python3 tools/sial_parse.py "База АЛЮТЕХ.xlsx"            (структура)
;;;   python3 tools/sial_parse.py "База АЛЮТЕХ.xlsx" --emit \
;;;       --system АЛЮТЕХ --prefix ALT --article-col 1 --size-col 5 \
;;;       >> MarkZV-bases.lsp
;;;
;;; Формат: артикул (ВЕРХНИМ регистром, без пробелов) . габарит сечения, мм
;;;=====================================================================

(mk:register-base "АЛЮТЕХ"
  '(
    ("ALT-W72-01" . 72.0)
    ("ALT-W72-05" . 116.0)
    ("ALT-W62-01" . 62.0)
  ))

;;; Префиксы артикулов этой системы — по ним артикул распознаётся
;;; в имени стиля мультилинии или в имени слоя.
(foreach p '("ALT")
  (if (not (member p *mk:article-prefixes*))
    (setq *mk:article-prefixes* (cons p *mk:article-prefixes*))))

(princ)
